{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "quiquitapo:submarino_guardian",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "quiquitapo:skin": {
          "type": "int",
          "range": [
            0,
            2
          ],
          "default": 0,
          "client_sync": true
        },
        "quiquitapo:velocidad": {
          "type": "int",
          "range": [
            0,
            1
          ],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "quiquitapo:vida_normal": {
        "minecraft:health": {
          "value": 30,
          "max": 30
        }
      },
      "quiquitapo:vida_blindaje": {
        "minecraft:health": {
          "value": 60,
          "max": 60
        }
      },
      "quiquitapo:en_agua": {
        "minecraft:physics": {
          "has_gravity": false
        }
      },
      "quiquitapo:en_tierra": {
        "minecraft:physics": {}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "quiquitapo_montura",
          "montura_submarino",
          "inanimate"
        ]
      },
      "minecraft:collision_box": {
        "width": 1.6,
        "height": 1.5
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no"
          },
          {
            "cause": "fly_into_wall",
            "deals_damage": "no"
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "rider_count",
                    "subject": "self",
                    "operator": "equals",
                    "value": 0
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "not",
                    "value": "player"
                  }
                ]
              }
            },
            "deals_damage": "no"
          },
          {
            "cause": "entity_explosion",
            "on_damage": {
              "filters": {
                "test": "rider_count",
                "subject": "self",
                "operator": "equals",
                "value": 0
              }
            },
            "deals_damage": "no"
          },
          {
            "cause": "block_explosion",
            "on_damage": {
              "filters": {
                "test": "rider_count",
                "subject": "self",
                "operator": "equals",
                "value": 0
              }
            },
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_sneak_held",
                    "subject": "other",
                    "value": true
                  },
                  {
                    "test": "rider_count",
                    "subject": "self",
                    "operator": "equals",
                    "value": 0
                  }
                ]
              },
              "event": "quiquitapo:recoger",
              "target": "self"
            },
            "interact_text": "action.interact.quiquitapo.recoger"
          }
        ]
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "crouching_skip_interact": true,
        "pull_in_entities": false,
        "family_types": [
          "player"
        ],
        "interact_text": "action.interact.quiquitapo.montar",
        "seats": {
          "position": [
            0.0,
            1.1,
            0.0
          ]
        }
      }
    },
    "events": {
      "quiquitapo:recoger": {},
      "quiquitapo:blindaje_on": {
        "remove": {
          "component_groups": [
            "quiquitapo:vida_normal"
          ]
        },
        "add": {
          "component_groups": [
            "quiquitapo:vida_blindaje"
          ]
        }
      },
      "quiquitapo:blindaje_off": {
        "remove": {
          "component_groups": [
            "quiquitapo:vida_blindaje"
          ]
        },
        "add": {
          "component_groups": [
            "quiquitapo:vida_normal"
          ]
        }
      },
      "quiquitapo:velocidad_normal": {
        "set_property": {
          "quiquitapo:velocidad": 0
        }
      },
      "quiquitapo:velocidad_alta": {
        "set_property": {
          "quiquitapo:velocidad": 1
        }
      },
      "quiquitapo:en_agua": {
        "remove": {
          "component_groups": [
            "quiquitapo:en_tierra"
          ]
        },
        "add": {
          "component_groups": [
            "quiquitapo:en_agua"
          ]
        }
      },
      "quiquitapo:en_tierra": {
        "remove": {
          "component_groups": [
            "quiquitapo:en_agua"
          ]
        },
        "add": {
          "component_groups": [
            "quiquitapo:en_tierra"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "quiquitapo:vida_normal",
            "quiquitapo:en_tierra"
          ]
        }
      }
    }
  }
}